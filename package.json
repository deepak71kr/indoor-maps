{
  "name": "inner-map",
  "private": true,
  "type": "module",
  "description": "Indoor navigation for campuses — colleges, hospitals, factories.",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "dev:visitor": "pnpm --filter @innermap/visitor dev",
    "dev:editor": "pnpm --filter @innermap/editor dev",
    "build": "pnpm --filter \"./apps/*\" build",
    "typecheck": "pnpm -r typecheck && tsc -p tools",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . && depcruise packages apps --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node tools/size-check.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm size",
    "route": "tsx tools/route.ts",
    "e2e": "pnpm --filter @innermap/visitor e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@innermap/core": "workspace:*",
    "@innermap/schema": "workspace:*",
    "@types/node": "^24.19.2",
    "dependency-cruiser": "^18.6.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "pnpm": "10.34.7",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
